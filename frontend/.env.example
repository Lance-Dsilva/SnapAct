# Cursor SDK (server-side only — never NEXT_PUBLIC_)
CURSOR_API_KEY=
CURSOR_MODEL=gpt-5.6-luna
CURSOR_SEARCH_MODEL=composer-2.5
USE_MOCK_CURSOR=false

# Supabase — SnapAct's system of record.
# Needs: the `memories` table (supabase/migrations), the `screenshots` bucket,
# and the `embed` edge function deployed.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BUCKET=screenshots

DEMO_USER_ID=demo-user

# Optional tuning
# HTTP_TIMEOUT_MS=30000
# MAX_IMAGE_BYTES=12582912
# SIGNED_URL_TTL_SECONDS=86400
# NEXT_PUBLIC_API_BASE_URL=
