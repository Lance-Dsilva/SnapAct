# SnapAct — Cursor SDK + Next.js (hackathon)

# Cursor / Grok (server-side ONLY — never NEXT_PUBLIC_)
CURSOR_API_KEY=
CURSOR_MODEL=grok-4.6
# Set true for offline UI/tests without calling Cursor
USE_MOCK_CURSOR=false

# Demo identity (no auth)
DEMO_USER_ID=demo-user

# Teammate RAG / Supabase HTTP gateway
MEMORY_SAVE_ENDPOINT=https://snap-act-eight.vercel.app/api/rag/index
MEMORY_SEARCH_ENDPOINT=https://snap-act-eight.vercel.app/api/rag/search
MEMORY_LIST_ENDPOINT=
MEMORY_GET_ENDPOINT=
MEMORY_UPDATE_ENDPOINT=
MEMORY_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=screenshots

# Optional: leave empty to use same-origin /api routes
# NEXT_PUBLIC_API_BASE_URL=
